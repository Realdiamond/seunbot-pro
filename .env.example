# SeunBot Pro - Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# SeunBot Backend (Required)
# ─────────────────────────────────────────────
# Base URL for the SeunBot Heroku trading bot API
VITE_SEUNBOT_API_BASE_URL=https://seun-trading-bot-api-2026-28f6d6f40e1b.herokuapp.com

# ─────────────────────────────────────────────
# Market Selection
# ─────────────────────────────────────────────
# Only NGX is supported by the backend. Do not enable crypto or sp500
# unless backend endpoints are added for those markets.
VITE_ENABLED_MARKETS=ngx