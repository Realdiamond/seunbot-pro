# Financial Data API Keys
# Copy this file to .env and add your API keys

# Alpha Vantage (Free tier: 25 calls/day)
# Get your key at: https://www.alphavantage.co/support/#api-key
VITE_ALPHAVANTAGE_API_KEY=your_alpha_vantage_key_here

# Twelve Data (Free tier: 800 calls/day)
# Get your key at: https://twelvedata.com/pricing
VITE_TWELVEDATA_API_KEY=your_twelve_data_key_here

# Financial Modeling Prep (Free tier: 250 calls/day)
# Get your key at: https://site.financialmodelingprep.com/developer/docs/pricing
VITE_FMP_API_KEY=your_fmp_key_here

# Polygon.io (Free tier: 5 calls/minute)
# Get your key at: https://polygon.io/pricing
VITE_POLYGON_API_KEY=your_polygon_key_here

# OpenAI API Key (for AI stock analysis)
# Get your key at: https://platform.openai.com/api-keys
# Free tier: $5 credit, each analysis costs ~$0.01-0.02
VITE_OPENAI_API_KEY=your_openai_key_here

# API Provider Priority (comma-separated)
# Options: alphavantage, twelvedata, fmp, polygon
VITE_API_PROVIDER_PRIORITY=twelvedata,alphavantage,fmp,polygon