# SeunBot Pro - Environment Variables
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# SeunBot Backend (Required)
# ─────────────────────────────────────────────
# Base URL for the SeunBot Heroku trading bot API
# SET THIS IN VERCEL ENVIRONMENT VARIABLES
VITE_SEUNBOT_API_BASE_URL=https://your-api-url.herokuapp.com

# ─────────────────────────────────────────────
# Market Selection
# ─────────────────────────────────────────────
# NGX and Crypto are supported by the backend.
# SET THIS IN VERCEL ENVIRONMENT VARIABLES
VITE_ENABLED_MARKETS=ngx,crypto